{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "3-Layer Production Design System",
  "version": "1.0.0",
  "primitive": {
    "color": {
      "neutral": {
        "0": { "$value": "#ffffff", "$type": "color" },
        "50": { "$value": "#fbfbfd", "$type": "color" },
        "100": { "$value": "#f4f5f8", "$type": "color" },
        "200": { "$value": "#e9ecf1", "$type": "color" },
        "300": { "$value": "#d6dbe4", "$type": "color" },
        "400": { "$value": "#94a3b8", "$type": "color" },
        "500": { "$value": "#64748b", "$type": "color" },
        "600": { "$value": "#475569", "$type": "color" },
        "700": { "$value": "#334155", "$type": "color" },
        "800": { "$value": "#1e293b", "$type": "color" },
        "900": { "$value": "#0f172a", "$type": "color" },
        "950": { "$value": "#0c0e12", "$type": "color" }
      },
      "blue": {
        "50": { "$value": "#eef2ff", "$type": "color" },
        "500": { "$value": "#3b5bfd", "$type": "color" },
        "600": { "$value": "#2d55ff", "$type": "color" },
        "700": { "$value": "#1d4ed8", "$type": "color" }
      },
      "emerald": {
        "50": { "$value": "#ecfdf5", "$type": "color" },
        "500": { "$value": "#10b981", "$type": "color" },
        "600": { "$value": "#059669", "$type": "color" }
      },
      "red": {
        "50": { "$value": "#fef2f2", "$type": "color" },
        "500": { "$value": "#ef4444", "$type": "color" },
        "600": { "$value": "#dc2626", "$type": "color" }
      }
    },
    "space": {
      "4": { "$value": "4px", "$type": "dimension" },
      "8": { "$value": "8px", "$type": "dimension" },
      "12": { "$value": "12px", "$type": "dimension" },
      "16": { "$value": "16px", "$type": "dimension" },
      "24": { "$value": "24px", "$type": "dimension" },
      "32": { "$value": "32px", "$type": "dimension" }
    },
    "radius": {
      "4": { "$value": "4px", "$type": "dimension" },
      "6": { "$value": "6px", "$type": "dimension" },
      "8": { "$value": "8px", "$type": "dimension" },
      "12": { "$value": "12px", "$type": "dimension" },
      "16": { "$value": "16px", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    }
  },
  "semantic": {
    "color": {
      "bg": {
        "canvas": {
          "$value": "{primitive.color.neutral.50}",
          "$type": "color",
          "$description": "App backdrop"
        },
        "surface": {
          "$value": "{primitive.color.neutral.0}",
          "$type": "color",
          "$description": "Card and container surface"
        },
        "brand": {
          "default": {
            "$value": "{primitive.color.blue.600}",
            "$type": "color",
            "$description": "Primary action fill"
          },
          "hover": {
            "$value": "{primitive.color.blue.700}",
            "$type": "color",
            "$description": "Primary action hover state"
          }
        }
      },
      "text": {
        "primary": {
          "$value": "{primitive.color.neutral.900}",
          "$type": "color",
          "$description": "Headings and primary copy"
        },
        "secondary": {
          "$value": "{primitive.color.neutral.600}",
          "$type": "color"
        },
        "inverse": {
          "$value": "{primitive.color.neutral.0}",
          "$type": "color"
        }
      },
      "border": {
        "default": {
          "$value": "{primitive.color.neutral.300}",
          "$type": "color"
        },
        "focus": {
          "$value": "{primitive.color.blue.500}",
          "$type": "color"
        }
      }
    },
    "radius": {
      "control": {
        "$value": "{primitive.radius.6}",
        "$type": "dimension"
      },
      "card": {
        "$value": "{primitive.radius.12}",
        "$type": "dimension"
      }
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": {
          "default": { "$value": "{semantic.color.bg.brand.default}", "$type": "color" },
          "hover": { "$value": "{semantic.color.bg.brand.hover}", "$type": "color" }
        },
        "text": { "$value": "{semantic.color.text.inverse}", "$type": "color" },
        "radius": { "$value": "{semantic.radius.control}", "$type": "dimension" }
      }
    },
    "input": {
      "bg": { "$value": "{semantic.color.bg.surface}", "$type": "color" },
      "border": {
        "default": { "$value": "{semantic.color.border.default}", "$type": "color" },
        "focus": { "$value": "{semantic.color.border.focus}", "$type": "color" }
      },
      "radius": { "$value": "{semantic.radius.control}", "$type": "dimension" }
    },
    "card": {
      "bg": { "$value": "{semantic.color.bg.surface}", "$type": "color" },
      "radius": { "$value": "{semantic.radius.card}", "$type": "dimension" }
    }
  }
}
